# Reference copy of the settings. You do not need to edit this: run
#
#   ./setup.sh configure
#
# and it asks for each value (with detected defaults), validates it and writes config/node.env.
# Copying this file to config/node.env and editing it by hand still works.
#
# This file holds NO secrets. API keys and tokens are always prompted for and
# stored only where the guide stores them (~/.hermes/.env, gh's credential
# store, C:\llama\api-key.txt). Plain bash syntax: KEY=value, quote values that
# contain spaces. The Windows scripts read the same file.

# ---- Machines and network (guide: "Addresses") -----------------------------
LAPTOP_IP=192.168.1.150
DESKTOP_IP=192.168.1.100
ROUTER_IP=192.168.1.1
LAN_CIDR=192.168.1.0/24
# Laptop admin account created by the Debian installer (Step 1) and the agent user (Step 6).
ADMIN_USER=ai-node
AGENT_USER=hermes
# Only this address may SSH in once the firewall is on (Step 28).
SSH_ALLOWED_FROM=192.168.1.100
DASHBOARD_PORT=9119
LLM_PORT=8080

# ---- GitHub (Step 8) -------------------------------------------------------
GITHUB_ORG=yourorg
# Space-separated. The first repo is the one the cron jobs (Step 27) work on.
GITHUB_REPOS="yourrepo"
GITHUB_MACHINE_USER=yourorg-hermes
# Machine account > Settings > Emails > the noreply address.
GITHUB_NOREPLY_EMAIL=12345678+yourorg-hermes@users.noreply.github.com

# ---- OpenRouter models (Steps 10, 11, 21) ----------------------------------
# The guide does not hard-code model names because they change often. Pick IDs
# from the live list in `hermes model` (the planner is chosen there, not here).
# Quality first: strong mid-tier coder for workers; a frontier reviewer from a
# DIFFERENT family than the planner; a capable summariser; a fallback from a
# different upstream company than the planner.
OR_WORKER_MODEL=
OR_REVIEW_MODEL=
OR_COMPRESSION_MODEL=
OR_FALLBACK_MODEL=
# Optional cheaper model for unpinned cron jobs (Step 27). Leave empty to skip.
CRON_MODEL=
REASONING_EFFORT=high
MAX_CONCURRENT_CHILDREN=3
MAX_ITERATIONS=200
APPROVAL_MODE=off
APPROVAL_DENY=1
WORKER_EFFORT=inherit
AGENT_SUDO=full
JOURNAL_MAX_MB=500
SPEND_WARN_PCT=80
BACKUP_KEEP=14
BACKUP_TIME=07:15
DESKTOP_BACKUP_DIR='C:\hermes-backups'
AUTO_AWAY_GPU_PCT=25
AUTO_AWAY_AFTER_MIN=2
AUTO_BACK_AFTER_MIN=15
DASHBOARD_FROM=none
SMB_SHARE=none

# ---- Laptop model: Qwen3.5-9B on the GTX 1070 (Step 18) --------------------
# If Q5 runs out of VRAM choose UD-Q4_K_XL here and set the file and URL to match (configure does that for you).
LAPTOP_QUANT=UD-Q5_K_XL
LAPTOP_MODEL_ALIAS=qwen3.5-9b
LAPTOP_MODEL_FILE=Qwen3.5-9B-UD-Q5_K_XL.gguf
LAPTOP_MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/main/Qwen3.5-9B-UD-Q5_K_XL.gguf
LAPTOP_CTX=131072
# 1 = keep the context cache in RAM (-nkvo). Set 0 only after Step 18's benchmark says so.
LAPTOP_KV_IN_RAM=1
LAPTOP_CACHE_RAM_MB=2048
LAPTOP_CHAT_KWARGS=enable_thinking=true
LAPTOP_SAMPLING='--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0'

# ---- Desktop model: Qwen3.6-35B-A3B on the RX 6600 XT (Step 19) ------------
# Use UD-Q4_K_XL if Windows memory runs above ~90% while generating.
DESKTOP_QUANT=UD-Q5_K_XL
DESKTOP_MODEL_ALIAS=qwen3.6-35b-a3b
DESKTOP_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf
DESKTOP_MODEL_URL=https://huggingface.co/unsloth/Qwen3.6-35B-A3B-GGUF/resolve/main/Qwen3.6-35B-A3B-UD-Q5_K_XL.gguf
DESKTOP_CTX=131072
# Experts of this many layers stay in RAM. Lower it until dedicated GPU memory is ~7.3GB.
DESKTOP_N_CPU_MOE=40
DESKTOP_CACHE_RAM_MB=1024
DESKTOP_CHAT_KWARGS=preserve_thinking=true
DESKTOP_SAMPLING='--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0 --presence-penalty 0'
DESKTOP_LLAMA_DIR='C:\llama'
DESKTOP_MODELS_DIR='C:\models'

# ---- Overnight quality tier: Qwen3.8-27B (Step 31, optional) ---------------
NIGHT_ENABLED=0
NIGHT_MODEL_ALIAS=qwen3.8-27b
NIGHT_MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf
NIGHT_MODEL_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-UD-Q4_K_XL.gguf
# GPU layers; raise until dedicated GPU memory is ~7.3GB (or use llama-fit-params).
NIGHT_NGL=16
NIGHT_CHAT_KWARGS=reasoning_effort=medium
NIGHT_SAMPLING='--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0'
NIGHT_MTP=1
NIGHT_START=01:00
NIGHT_END=07:00

# ---- V100 GPU tier: Tesla V100 SXM2 cards in the desktop (optional, docs/V100.md) -----
V100_ENABLED=0
V100_COUNT=2
# 16 or 32 (GB per card)
V100_VRAM_GB=16
V100_QUANT=UD-Q4_K_XL
V100_MODEL_ALIAS=qwen3.8-27b
V100_MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf
V100_MODEL_URL=https://huggingface.co/unsloth/Qwen3.8-27B-GGUF/resolve/main/Qwen3.8-27B-UD-Q4_K_XL.gguf
V100_CTX=131072
# Must differ from LLM_PORT. Only the laptop may reach it.
V100_PORT=8081
# 1 = faster generation with the model's built-in MTP head (when the file has one)
V100_MTP=1
V100_CHAT_KWARGS=auto
V100_SAMPLING=auto
# layer (safe) or tensor (experimental, see docs/V100.md)
V100_SPLIT_MODE=layer
# 1 = the V100 model is the first local choice (local profile and fallback chain)
V100_PRIMARY=1
# TCC = compute-only (no display, no Vulkan); MCDM only for WSL2
V100_DRIVER_MODE=TCC
# per card, 0 = the card's stock limit
V100_POWER_LIMIT_W=200
V100_CUDA_DIR='C:\llama-cuda'
