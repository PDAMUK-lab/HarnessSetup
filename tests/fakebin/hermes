#!/usr/bin/env bash
# Test stub for the hermes CLI: records calls, emulates just enough profile/cron state.
echo "hermes $*" >>"${FAKE_LOG:-/dev/null}"
profile=''
if [[ ${1:-} == -p ]]; then profile=$2; shift 2; fi
home=$HOME/.hermes; [[ -n $profile && $profile != default ]] && home=$HOME/.hermes/profiles/$profile
case "${1:-} ${2:-}" in
  "profile create")
    dst=$HOME/.hermes/profiles/$3; mkdir -p "$dst"
    if [[ " $* " == *" --clone "* ]]; then cp "$HOME/.hermes/config.yaml" "$HOME/.hermes/.env" "$dst/" 2>/dev/null; fi ;;
  "chat -q")
    if [[ -n ${FAKE_ANSWERS:-} && -s $FAKE_ANSWERS ]]; then
      line=$(head -1 "$FAKE_ANSWERS"); sed -i 1d "$FAKE_ANSWERS"
      [[ $line == FAIL ]] && { echo "error: all providers failed" >&2; exit 1; }
      echo "$line"
    fi ;;
  "gateway status") echo "gateway: running" ;;
  "chat --query-file")   # the model-test runner: "do the task" by creating the file the prompt names (FAKE_CHAT=lazy does nothing)
    [[ ${FAKE_CHAT:-} == lazy ]] || { f=$(grep -oE 'create [A-Za-z0-9._-]+' "$3" | head -1 | cut -d' ' -f2); [[ -n $f ]] && echo ok >"$f"; } ;;
  "config get")
    # like Hermes: booleans in lower case; a missing file or key is an error
    python3 - "$home/config.yaml" "${3:-}" <<'PY' 2>/dev/null || exit 1
import sys, yaml
d = yaml.safe_load(open(sys.argv[1])) or {}
for k in sys.argv[2].split("."):
    d = d[k]
print(str(d).lower() if isinstance(d, bool) else d)
PY
    ;;
  "fallback list")
    # like the real chain: offline has no openrouter entry; with the desktop out of the loop (hermes-desktop off) no desktop entry
    offline=0
    if [[ -n ${NODE_ENV:-} && -f ${NODE_ENV:-} ]] && grep -q '^OFFLINE=1' "$NODE_ENV" 2>/dev/null; then offline=1; fi
    if ((offline)); then
      if [[ -e $HOME/.hermes/desktop-away ]]; then printf '1. custom:laptop\n'
      else printf '1. custom:desktop\n2. custom:laptop\n'; fi
    elif [[ -e $HOME/.hermes/desktop-away ]]; then printf '1. openrouter\n2. custom:laptop\n'
    else printf '1. openrouter\n2. custom:desktop\n3. custom:laptop\n'; fi ;;
  "profile list") echo default; ls "$HOME/.hermes/profiles" 2>/dev/null ;;
  "skills list") cat "$home/fake-skills" 2>/dev/null ;;
  "skills install")
    # FAKE_SKILL_FAIL names a skill whose install fails (as a security-scan block would)
    [[ -n ${FAKE_SKILL_FAIL:-} && $3 == *"/$FAKE_SKILL_FAIL" ]] && { echo "Not installed: ${3##*/}" >&2; exit 1; }
    mkdir -p "$home"; echo "${3##*/}" >>"$home/fake-skills" ;;
  "cron list") cat "$home/fake-cron" 2>/dev/null ;;
  "cron create")
    name=''; prev=''; script=''
    for a in "$@"; do
      [[ $prev == --name ]] && name=$a
      [[ $prev == --script ]] && script=$a
      prev=$a
    done
    # like the real CLI: without -p the ACTIVE profile decides where scripts live (hermes_constants'
    # HERMES_HOME), and --script must exist there; an absolute path is refused by design, so the kit
    # has to install the script into the profile the agent actually runs on
    if [[ -n $script ]]; then
      shome=$home
      if [[ -z $profile && -f $HOME/.hermes/active_profile ]]; then
        ap=$(cat "$HOME/.hermes/active_profile")
        [[ -n $ap && $ap != default ]] && shome="$HOME/.hermes/profiles/$ap"
      fi
      if [[ ! -f "$shome/scripts/$script" ]]; then
        echo "Script file not found: $shome/scripts/$script. Create it in $shome/scripts/ first." >&2
        exit 1
      fi
    fi
    mkdir -p "$home"; echo "$name" >>"$home/fake-cron" ;;
esac
exit 0
