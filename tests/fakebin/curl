#!/usr/bin/env bash
# Test stub for curl: only the URLs the stages and tools use in a real run
[[ -n ${FAKE_CURL_REAL:-} ]] && exec /usr/bin/curl "$@"
case "$*" in
  *api/status*) echo '{"auth_required": false}' ;;
  *hermes-agent*install.sh*) printf 'printf "%%s\\n" "$*" >"$HOME/.hermes-install-args"\nmkdir -p "$HOME/.local/bin"\ncp "%s" "$HOME/.local/bin/hermes"\n' "${FAKE_HERMES_SRC:-$(dirname "$0")/hermes}" ;;
  *http_code*) printf '%s' "${FAKE_HTTP_CODE:-200}" ;;
  *openrouter.ai/api/v1/key*)
    def='{"data":{"label":"t","limit":50,"limit_remaining":40,"limit_reset":"monthly","usage":10,"usage_monthly":10}}'
    printf '%s\n' "${FAKE_OR_KEY:-$def}" ;;
  */v1/models*) echo '{"data":[{"id":"'"${FAKE_MODEL_ID:-qwen3.5-9b}"'"}]}' ;;
esac
exit 0
